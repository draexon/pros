{
  "name": "@draexon/pros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original monochrome React components, made to move.",
  "author": "draexon",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "main": "./dist/pros.cjs",
  "module": "./dist/pros.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pros.js",
      "require": "./dist/pros.cjs"
    },
    "./style.css": "./dist/pros.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "build:lib": "node node_modules/vite/bin/vite.js build --config vite.lib.config.ts && node node_modules/typescript/bin/tsc -p tsconfig.lib.json",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/library.test.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "pretest": "npm run build:lib",
    "publish:private": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publish-private.ps1",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
